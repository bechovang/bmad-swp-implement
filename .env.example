# StorageHub - backend environment variables (story 1.1 onward).
# Copy to your own private location and export before `mvn spring-boot:run` /
# `mvn test`. Spring Boot / Maven do NOT auto-load .env files - README
# "Backend env vars" lists per-shell export commands.
# NEVER commit real values; only this name template lives in git.

# --- Required today: the app fails fast at boot without these (JDBC -> MySQL 8.4)
DB_URL=jdbc:mysql://localhost:3306/storagehub
DB_USERNAME=root
DB_PASSWORD=change-me

# --- Consumed later, not yet read by any code (fail-fast arrives with their stories)
JWT_SECRET=change-me-at-least-32-chars
PAYOS_CLIENT_ID=change-me
PAYOS_API_KEY=change-me
PAYOS_CHECKSUM_KEY=change-me

# --- Test-only: dedicated schema for StorageHubNonDevProfileTests (optional,
# defaults to jdbc:mysql://localhost:3306/storagehub_nondev_test?createDatabaseIfNotExist=true)
# DB_URL_NONDEV=jdbc:mysql://localhost:3306/storagehub_nondev_test?createDatabaseIfNotExist=true
